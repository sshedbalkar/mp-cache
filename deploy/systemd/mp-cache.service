[Unit]
Description=mp-cache local Unix-socket cache service
After=network.target

[Service]
Type=simple
User=mp-cache
Group=mp-cache
WorkingDirectory=/opt/mp-cache
ExecStart=/opt/mp-cache/build/local-debug/mp-cache-server --config /opt/mp-cache/configs/env/production.ini
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mp-cache /var/log/mp-cache /run/mp-cache
RuntimeDirectory=mp-cache
RuntimeDirectoryMode=0750
StateDirectory=mp-cache
StateDirectoryMode=0750
LogsDirectory=mp-cache
LogsDirectoryMode=0750
LimitNOFILE=4096
UMask=0027

[Install]
WantedBy=multi-user.target
