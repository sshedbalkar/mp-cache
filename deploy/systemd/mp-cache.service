[Unit]
Description=mp-cache Unix-socket cache service
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/opt/mp-cache /var/lib/mp-cache /var/log/mp-cache /run/secrets/mp-cache

[Service]
Type=simple
User=mp-cache
Group=mp-cache
WorkingDirectory=/opt/mp-cache/current
ExecStart=/opt/mp-cache/current/bin/mp-cache-server --config /opt/mp-cache/current/configs/env/production.yaml
Restart=always
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mp-cache /var/log/mp-cache /run/mp-cache
RuntimeDirectory=mp-cache
RuntimeDirectoryMode=0750
StateDirectory=mp-cache
StateDirectoryMode=0750
LogsDirectory=mp-cache
LogsDirectoryMode=0750
LimitNOFILE=4096
UMask=0007

[Install]
WantedBy=multi-user.target
