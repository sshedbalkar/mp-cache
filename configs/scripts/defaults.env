# Shared shell-script defaults for mp-cache automation.
#
# Keep operator-tunable script defaults here instead of embedding fallback
# values in scripts. Existing environment variables still take precedence.

: "${MP_SCRIPT_DEFAULT_CONFIG_PATH:=configs/bootstrap.ini}"
: "${MP_SCRIPT_DEFAULT_NGINX_PATH_CONFIG_PATH:=configs/deploy/nginx-paths.env}"

: "${MP_SCRIPT_DEFAULT_LOCAL_BUILD_PRESET:=local-debug}"
: "${MP_SCRIPT_DEFAULT_LOCAL_BUILD_DIR:=build/local-debug}"
: "${MP_SCRIPT_DEFAULT_SANITIZER_BUILD_PRESET:=local-asan-ubsan}"
: "${MP_SCRIPT_DEFAULT_SANITIZER_BUILD_DIR:=build/local-asan-ubsan}"
: "${MP_SCRIPT_DEFAULT_PACKAGE_DIR:=dist}"
: "${MP_SCRIPT_DEFAULT_LOCAL_PACKAGE_DIR:=dist/local}"
: "${MP_SCRIPT_DEFAULT_PROMOTION_DIR:=dist/promotions}"
: "${MP_SCRIPT_DEFAULT_ARTIFACT_COMMIT:=local}"
: "${MP_SCRIPT_DEFAULT_ARTIFACT_BUILD_TIME:=1970-01-01T00:00:00Z}"

: "${MP_SCRIPT_DEFAULT_TEST_REPORT_DIR:=.tmp/test-reports}"
: "${MP_SCRIPT_DEFAULT_STANDARDS_MINIMUM_SCORE:=85}"
: "${MP_SCRIPT_DEFAULT_LOCAL_RUN_DIR:=.tmp/run}"
: "${MP_SCRIPT_DEFAULT_LOCAL_LOG_DIR:=.tmp/logs}"
: "${MP_SCRIPT_DEFAULT_LOCAL_DATA_DIR:=.tmp/data}"
: "${MP_SCRIPT_DEFAULT_LOCAL_EXPORT_DIR:=.tmp/exports}"
: "${MP_SCRIPT_DEFAULT_LOCAL_SECRET_DIR:=.tmp/secrets}"
: "${MP_SCRIPT_DEFAULT_LOCAL_SECRET_FILE:=.tmp/secrets/local.env}"
: "${MP_SCRIPT_DEFAULT_LOCAL_CONSOLE_LOG:=.tmp/logs/console.log}"
: "${MP_SCRIPT_DEFAULT_LOCAL_APP_LOG_DIR:=logging}"
: "${MP_SCRIPT_DEFAULT_VALGRIND_CORE_DIR:=.tmp/valgrind/cores}"
: "${MP_SCRIPT_DEFAULT_VALGRIND_LOADER_PRIMARY:=/lib64/ld-linux-x86-64.so.2}"
: "${MP_SCRIPT_DEFAULT_VALGRIND_LOADER_FALLBACK:=/usr/lib/ld-linux-x86-64.so.2}"

: "${MP_SCRIPT_DEFAULT_LOCAL_AUTO_RESET_ON_LOAD_FAILURE:=1}"
: "${MP_SCRIPT_DEFAULT_ALLOW_ENV_MISMATCH:=0}"

: "${MP_SCRIPT_DEFAULT_SYSTEM_RUNTIME_ROOT:=/run}"
: "${MP_SCRIPT_DEFAULT_SYSTEM_STATE_ROOT:=/var/lib}"
: "${MP_SCRIPT_DEFAULT_SYSTEM_LOG_ROOT:=/var/log}"
: "${MP_SCRIPT_DEFAULT_SYSTEMD_UNIT_DIR:=/etc/systemd/system}"

: "${MP_SCRIPT_DEFAULT_LOCAL_DEPLOY_SERVICE_NAME:=mp-cache-local}"
: "${MP_SCRIPT_DEFAULT_LOCAL_DEPLOY_SHOULD_BUILD:=1}"
: "${MP_SCRIPT_DEFAULT_LOCAL_DEPLOY_USE_ARTIFACT:=1}"
: "${MP_SCRIPT_DEFAULT_LOCAL_DEPLOY_GENERATED_DIR:=.tmp/deploy/local}"
: "${MP_SCRIPT_DEFAULT_LOCAL_DEPLOY_REPORT_SUBDIR:=reports}"
: "${MP_SCRIPT_DEFAULT_LOCAL_DEPLOY_NGINX_LISTEN:=127.0.0.1:8080}"
: "${MP_SCRIPT_DEFAULT_LOCAL_NGINX_SERVER_NAMES:=localhost mp-cache.local}"
: "${MP_SCRIPT_DEFAULT_LOCAL_HTTP_HOST:=localhost}"

: "${MP_SCRIPT_DEFAULT_REMOTE_DEPLOY_ROOT:=/opt/mp-cache}"
: "${MP_SCRIPT_DEFAULT_REMOTE_SERVICE_NAME:=mp-cache}"
: "${MP_SCRIPT_DEFAULT_REMOTE_NGINX_LISTEN:=127.0.0.1:8080}"
: "${MP_SCRIPT_DEFAULT_REMOTE_INSTALL_NGINX:=1}"
: "${MP_SCRIPT_DEFAULT_REMOTE_STAGING_ROOT:=/tmp}"
: "${MP_SCRIPT_DEFAULT_REMOTE_NGINX_SERVER_NAME:=_}"
: "${MP_SCRIPT_DEFAULT_REMOTE_NOLOGIN_PRIMARY:=/usr/sbin/nologin}"
: "${MP_SCRIPT_DEFAULT_REMOTE_NOLOGIN_FALLBACK:=/sbin/nologin}"

: "${MP_SCRIPT_DEFAULT_SYSTEMD_RESTART_POLICY:=always}"
: "${MP_SCRIPT_DEFAULT_SYSTEMD_RESTART_SEC:=2s}"
: "${MP_SCRIPT_DEFAULT_LOCAL_SYSTEMD_RUNTIME_MODE:=0755}"
: "${MP_SCRIPT_DEFAULT_REMOTE_SYSTEMD_RUNTIME_MODE:=0750}"
: "${MP_SCRIPT_DEFAULT_SYSTEMD_STATE_MODE:=0750}"
: "${MP_SCRIPT_DEFAULT_SYSTEMD_LOGS_MODE:=0750}"
: "${MP_SCRIPT_DEFAULT_SYSTEMD_LIMIT_NOFILE:=4096}"
: "${MP_SCRIPT_DEFAULT_LOCAL_SYSTEMD_UMASK:=0000}"
: "${MP_SCRIPT_DEFAULT_REMOTE_SYSTEMD_UMASK:=0007}"
