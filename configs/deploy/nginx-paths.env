# Nginx path constants used by local and remote deployment scripts.
#
# Keep these paths centralized so host layout changes do not require edits in
# generated Nginx config templates or deploy automation. Operators may override
# any value in the calling environment before sourcing this file.

: "${MP_CACHE_NGINX_MAIN_CONFIG_FILE:=/etc/nginx/nginx.conf}"
: "${MP_CACHE_NGINX_CONF_DIR:=/etc/nginx/conf.d}"
: "${MP_CACHE_NGINX_SITES_AVAILABLE_DIR:=/etc/nginx/sites-available}"
: "${MP_CACHE_NGINX_SITES_ENABLED_DIR:=/etc/nginx/sites-enabled}"
: "${MP_CACHE_NGINX_LOG_DIR:=/var/log/nginx}"
: "${MP_CACHE_NGINX_REMOTE_CONF_FILE_NAME:=mp-cache.conf}"
: "${MP_CACHE_NGINX_LOCATION_PATH:=/cache}"
: "${MP_CACHE_NGINX_ERROR_LOG_LEVEL:=warn}"
